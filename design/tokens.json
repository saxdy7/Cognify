{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Cognify",
    "source": "src/app/globals.css",
    "colorSpace": "oklch",
    "themes": ["light", "dark"],
    "note": "Canonical values live in globals.css; this file mirrors them for tooling (Figma plugins, style-dictionary, agents)."
  },
  "color": {
    "background":          { "light": "oklch(0.99 0 0)",   "dark": "oklch(0.13 0 0)" },
    "foreground":          { "light": "oklch(0.145 0 0)",  "dark": "oklch(0.985 0 0)" },
    "card":                { "light": "oklch(1 0 0)",      "dark": "oklch(0.17 0 0)" },
    "card-foreground":     { "light": "oklch(0.145 0 0)",  "dark": "oklch(0.985 0 0)" },
    "popover":             { "light": "oklch(1 0 0)",      "dark": "oklch(0.18 0 0)" },
    "popover-foreground":  { "light": "oklch(0.145 0 0)",  "dark": "oklch(0.985 0 0)" },
    "primary":             { "light": "oklch(0.205 0 0)",  "dark": "oklch(0.922 0 0)" },
    "primary-foreground":  { "light": "oklch(0.985 0 0)",  "dark": "oklch(0.205 0 0)" },
    "secondary":           { "light": "oklch(0.97 0 0)",   "dark": "oklch(0.24 0 0)" },
    "secondary-foreground":{ "light": "oklch(0.205 0 0)",  "dark": "oklch(0.985 0 0)" },
    "muted":               { "light": "oklch(0.97 0 0)",   "dark": "oklch(0.22 0 0)" },
    "muted-foreground":    { "light": "oklch(0.5 0 0)",    "dark": "oklch(0.708 0 0)" },
    "accent":              { "light": "oklch(0.96 0 0)",   "dark": "oklch(0.26 0 0)" },
    "accent-foreground":   { "light": "oklch(0.205 0 0)",  "dark": "oklch(0.985 0 0)" },
    "destructive":         { "light": "oklch(0.577 0.245 27.325)", "dark": "oklch(0.704 0.191 22.216)" },
    "border":              { "light": "oklch(0.922 0 0)",  "dark": "oklch(1 0 0 / 10%)" },
    "input":               { "light": "oklch(0.922 0 0)",  "dark": "oklch(1 0 0 / 15%)" },
    "ring":                { "light": "oklch(0.708 0 0)",  "dark": "oklch(0.556 0 0)" },
    "sidebar":             { "light": "oklch(0.985 0 0)",  "dark": "oklch(0.16 0 0)" },
    "sidebar-foreground":  { "light": "oklch(0.145 0 0)",  "dark": "oklch(0.985 0 0)" },
    "sidebar-primary":     { "light": "oklch(0.205 0 0)",  "dark": "oklch(0.7 0.19 47)" },
    "sidebar-accent":      { "light": "oklch(0.955 0 0)",  "dark": "oklch(0.24 0 0)" },
    "sidebar-border":      { "light": "oklch(0.922 0 0)",  "dark": "oklch(1 0 0 / 10%)" },
    "sidebar-ring":        { "light": "oklch(0.708 0 0)",  "dark": "oklch(0.556 0 0)" },

    "brand":               { "light": "oklch(0.7 0.19 47)",  "dark": "oklch(0.75 0.18 50)", "role": "Bookmarks workspace accent (orange)" },
    "brand-foreground":    { "light": "oklch(0.985 0 0)",    "dark": "oklch(0.145 0 0)" },
    "canvas":              { "light": "oklch(0.65 0.2 20)",  "dark": "oklch(0.7 0.19 18)",  "role": "Canvas workspace accent (rose)" },
    "docs":                { "light": "oklch(0.7 0.15 162)", "dark": "oklch(0.75 0.15 160)", "role": "Docs workspace accent (emerald); also Liveblocks --lb-accent" },
    "ai":                  { "light": "oklch(0.6 0.2 275)",  "dark": "oklch(0.7 0.16 280)", "role": "AI copilot + unread/inbox accent (indigo)" },

    "chart-1": { "light": "oklch(0.7 0.19 47)",  "dark": "oklch(0.7 0.19 47)" },
    "chart-2": { "light": "oklch(0.7 0.15 162)", "dark": "oklch(0.7 0.15 162)" },
    "chart-3": { "light": "oklch(0.65 0.2 20)",  "dark": "oklch(0.65 0.2 20)" },
    "chart-4": { "light": "oklch(0.6 0.2 275)",  "dark": "oklch(0.6 0.2 275)" },
    "chart-5": { "light": "oklch(0.556 0 0)",    "dark": "oklch(0.556 0 0)" }
  },
  "accentOpacitySteps": { "hoverWash": 5, "selectedFill": 10, "iconChip": 15, "sidebarGradient": 20, "selectedBorder": 40 },
  "font": {
    "sans":    { "family": "Geist",         "cssVar": "--font-sans",    "use": "UI and body" },
    "heading": { "family": "Space Grotesk", "cssVar": "--font-heading", "use": "h1–h6, page and doc titles" },
    "mono":    { "family": "Geist Mono",    "cssVar": "--font-mono",    "use": "code, ids, kbd" }
  },
  "typeScale": {
    "pageTitle":   "text-2xl sm:text-3xl font-semibold tracking-tight",
    "docTitle":    "text-3xl sm:text-4xl font-heading font-bold tracking-tight",
    "sectionTitle":"text-lg font-semibold tracking-tight",
    "cardTitle":   "text-sm font-semibold",
    "body":        "text-sm",
    "meta":        "text-xs text-muted-foreground",
    "eyebrow":     "text-[10px] font-semibold uppercase tracking-wider text-muted-foreground",
    "stat":        "text-3xl font-semibold tracking-tight"
  },
  "radius": { "base": "0.625rem", "sm": "×0.6", "md": "×0.8", "lg": "×1", "xl": "×1.4", "2xl": "×1.8" },
  "layout": {
    "pagePadding": "p-6 md:p-8",
    "maxWidth": { "grid": "max-w-7xl", "list": "max-w-5xl", "reading": "max-w-3xl" },
    "headerHeight": "h-14",
    "sidebarWidth": "16rem",
    "sidebarIconWidth": "3rem",
    "gridGap": { "small": "gap-4", "cards": "gap-5" },
    "canvasHeight": "h-[calc(100vh-5.5rem)]"
  },
  "cardGradients": [
    "from-orange-200/70 to-orange-50 dark:from-orange-500/25 dark:to-orange-500/5",
    "from-rose-200/70 to-rose-50 dark:from-rose-500/25 dark:to-rose-500/5",
    "from-emerald-200/70 to-emerald-50 dark:from-emerald-500/25 dark:to-emerald-500/5",
    "from-sky-200/70 to-sky-50 dark:from-sky-500/25 dark:to-sky-500/5",
    "from-violet-200/70 to-violet-50 dark:from-violet-500/25 dark:to-violet-500/5",
    "from-amber-200/70 to-amber-50 dark:from-amber-500/25 dark:to-amber-500/5",
    "from-teal-200/70 to-teal-50 dark:from-teal-500/25 dark:to-teal-500/5",
    "from-pink-200/70 to-pink-50 dark:from-pink-500/25 dark:to-pink-500/5"
  ],
  "motion": {
    "transition": "transition-colors duration-200",
    "cardHover": "hover:scale-[1.02] | hover:shadow-md (pick one)",
    "imageHover": "group-hover:scale-105 duration-700",
    "chevronHover": "group-hover:translate-x-0.5",
    "keyframes": { "popover-in": "160ms cubic-bezier(0.23,1,0.32,1)", "card-in": "160ms opacity" },
    "reducedMotion": "keyframes disabled under prefers-reduced-motion"
  }
}
